{
  "name": "sistema-coexistente-wpp",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de atendimento multiagente via WhatsApp Cloud API oficial, com suporte a coexistência.",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @coexistente/api db:migrate",
    "db:seed": "pnpm --filter @coexistente/api db:seed",
    "db:studio": "pnpm --filter @coexistente/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
