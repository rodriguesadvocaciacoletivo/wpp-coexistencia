// =============================================================================
// Sistema Coexistente Wpp — schema
//
// Fase 1: identidade, sessão, equipe e configuração de e-mail.
// Fase 2: caixas de entrada (conexão com a Cloud API) e templates.
//
// Contatos, conversas, mensagens, etiquetas e eventos de webhook entram na
// Fase 3.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // "native" cobre a máquina de desenvolvimento e a VPS.
  // "rhel-openssl-3.0.x" é o runtime das funções serverless da Vercel — sem
  // esse alvo, o build gera o client mas o engine não existe em produção.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Conexão usada em runtime. No Supabase pode ser a do pooler (porta 6543).
  url       = env("DATABASE_URL")
  // Conexão usada por `prisma migrate` e `prisma db push`.
  // Precisa ser a conexão direta (porta 5432): migrations executam DDL e
  // comandos que o PgBouncer em modo transaction não suporta.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  agent
}

enum UserStatus {
  /// Convite enviado, senha ainda não definida. Não consegue autenticar.
  invited
  active
  /// Desativado por um administrador. Não autentica e tem as sessões revogadas.
  disabled
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  /// Hash argon2id. Nulo enquanto o convite não for aceito.
  passwordHash String?    @map("password_hash")
  role         UserRole
  status       UserStatus @default(invited)
  avatarUrl    String?    @map("avatar_url")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  teamMemberships TeamMember[]
  invitationsSent Invitation[]   @relation("InvitationCreatedBy")
  auditLogs      AuditLog[]
  inboxMemberships InboxMember[]

  @@index([status])
  @@map("users")
}

/// Sessão de refresh. Uma linha por sessão ativa; a rotação cria uma nova linha
/// e marca a anterior como revogada, permitindo detectar reuso de token roubado.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 do token. O valor em claro só existe no cookie do cliente.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  /// Aponta para o token que substituiu este na rotação.
  replacedById String? @map("replaced_by_id") @db.Uuid
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Convite de novo membro. O token em claro só existe no link enviado por e-mail.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.VarChar(255)
  name        String    @db.VarChar(120)
  role        UserRole
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

/// Token de recuperação de senha. Uso único, validade curta.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Configuração de SMTP. Singleton — sempre no máximo uma linha, com id fixo.
model SmtpSettings {
  id                String   @id @default("default")
  host              String   @db.VarChar(255)
  port              Int
  /// true = TLS implícito (465). false = STARTTLS (587) ou sem TLS.
  secure            Boolean  @default(false)
  username          String?  @db.VarChar(255)
  /// AES-256-GCM. Nunca sai da API em nenhuma resposta.
  passwordEncrypted String?  @map("password_encrypted")
  fromName          String   @map("from_name") @db.VarChar(120)
  fromEmail         String   @map("from_email") @db.VarChar(255)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("smtp_settings")
}

// =============================================================================
// Fase 2 — Conexão com a WhatsApp Cloud API
// =============================================================================

/// Como o número foi conectado. Ver docs/adr/001-onboarding-duplo.md.
enum InboxOnboardingType {
  /// Cloud API pura: credenciais informadas manualmente pelo administrador.
  manual
  /// Coexistência: número segue ativo no app WhatsApp Business, conectado via
  /// Embedded Signup. Depende da aprovação como Tech Provider.
  coexistence
}

enum InboxConnectionStatus {
  /// Criada, mas ainda sem validação bem-sucedida contra a Graph API.
  pending
  connected
  /// Token revogado, número removido da WABA ou falha persistente.
  error
}

enum InboxTokenType {
  /// System User Token colado pelo administrador (modo manual).
  system_user
  /// Token escopado ao cliente, obtido pela troca do code do Embedded Signup.
  business
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  /// Pausado pela Meta por qualidade baixa. Volta a APPROVED sozinho.
  PAUSED
  /// Desabilitado após pausas repetidas. Não volta.
  DISABLED
  /// Estados menos comuns retornados pela Graph API.
  IN_APPEAL
  PENDING_DELETION
  DELETED
  LIMIT_EXCEEDED
}

/// Uma caixa de entrada é um número de WhatsApp conectado à plataforma.
model Inbox {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(120)
  /// Número em formato de exibição, como informado pelo administrador.
  phoneNumber    String              @map("phone_number") @db.VarChar(32)
  /// Identificador do número na Cloud API. Único: um número, uma caixa.
  phoneNumberId  String              @unique @map("phone_number_id") @db.VarChar(64)
  wabaId         String              @map("waba_id") @db.VarChar(64)

  /// AES-256-GCM. Nunca sai da API em nenhuma resposta.
  tokenEncrypted String              @map("token_encrypted")
  tokenType      InboxTokenType      @default(system_user) @map("token_type")

  /// Imutável após a criação — converter um número entre os modos exigiria
  /// tirá-lo da WABA atual, e números em coexistência não migram entre WABAs.
  onboardingType InboxOnboardingType @default(manual) @map("onboarding_type")

  connectionStatus InboxConnectionStatus @default(pending) @map("connection_status")
  /// Última mensagem de erro da Meta, para diagnóstico do administrador.
  connectionError  String?               @map("connection_error")
  lastValidatedAt  DateTime?             @map("last_validated_at")

  /// Teto de envio por segundo. Coexistência é fixa em 20 mps; Cloud API pura
  /// escalona conforme o tier da Meta. Lido pela fila de envio na Fase 3 —
  /// nunca use constante no código.
  throughputLimitMps Int      @default(80) @map("throughput_limit_mps")

  /// Preenchido ao concluir a sincronização inicial de histórico e contatos,
  /// que a Meta limita a 24h após o onboarding de coexistência.
  coexistenceSyncedAt DateTime? @map("coexistence_synced_at")

  // Dados espelhados da Graph API, exibidos na tela da caixa.
  verifiedName        String?   @map("verified_name") @db.VarChar(160)
  qualityRating       String?   @map("quality_rating") @db.VarChar(24)
  messagingTier       String?   @map("messaging_tier") @db.VarChar(48)
  wabaName            String?   @map("waba_name") @db.VarChar(160)
  wabaReviewStatus    String?   @map("waba_review_status") @db.VarChar(48)

  webhookSubscribedAt DateTime? @map("webhook_subscribed_at")
  templatesSyncedAt   DateTime? @map("templates_synced_at")

  /// Soft delete: conversas e histórico são preservados para consulta.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  members   InboxMember[]
  templates Template[]

  @@index([connectionStatus])
  @@index([deletedAt])
  @@map("inboxes")
}

/// Quais agentes atendem a caixa.
model InboxMember {
  inboxId String   @map("inbox_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inboxId, userId])
  @@index([userId])
  @@map("inbox_members")
}

/// Template de mensagem espelhado da WABA.
///
/// A fonte de verdade é a Meta: este registro é um cache sincronizado, nunca
/// editado diretamente. Alterações vão pela Graph API e voltam pelo sync ou
/// pelo webhook `message_template_status_update`.
model Template {
  id       String @id @default(uuid()) @db.Uuid
  inboxId  String @map("inbox_id") @db.Uuid
  /// Identificador do template na Meta.
  metaId   String @map("meta_id") @db.VarChar(64)
  name     String @db.VarChar(512)
  language String @db.VarChar(16)

  category TemplateCategory
  status   TemplateStatus

  /// Estrutura completa: header, body, footer e botões, como a Meta devolve.
  /// Guardada em bruto para renderizar o preview e montar o envio sem
  /// reinterpretar o formato dela.
  components Json

  /// Motivo da recusa, quando houver.
  rejectedReason String? @map("rejected_reason") @db.VarChar(255)
  qualityScore   String? @map("quality_score") @db.VarChar(24)

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  /// A Meta permite o mesmo nome em idiomas diferentes — o par é que é único.
  @@unique([inboxId, name, language])
  @@index([inboxId, status])
  @@map("templates")
}

/// Trilha de auditoria de ações administrativas.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(60)
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
