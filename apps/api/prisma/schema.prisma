// =============================================================================
// Sistema Coexistente Wpp — schema
//
// Fase 1: identidade, sessão, equipe e configuração de e-mail.
// Fase 2: caixas de entrada (conexão com a Cloud API) e templates.
// Fase 3: contatos, conversas, mensagens, anexos e eventos de webhook.
//
// Etiquetas entram na Fase 5.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // "native" cobre a máquina de desenvolvimento e a VPS.
  // "rhel-openssl-3.0.x" é o runtime das funções serverless da Vercel — sem
  // esse alvo, o build gera o client mas o engine não existe em produção.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Conexão usada em runtime. No Supabase pode ser a do pooler (porta 6543).
  url       = env("DATABASE_URL")
  // Conexão usada por `prisma migrate` e `prisma db push`.
  // Precisa ser a conexão direta (porta 5432): migrations executam DDL e
  // comandos que o PgBouncer em modo transaction não suporta.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  agent
}

enum UserStatus {
  /// Convite enviado, senha ainda não definida. Não consegue autenticar.
  invited
  active
  /// Desativado por um administrador. Não autentica e tem as sessões revogadas.
  disabled
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  /// Hash argon2id. Nulo enquanto o convite não for aceito.
  passwordHash String?    @map("password_hash")
  role         UserRole
  status       UserStatus @default(invited)
  avatarUrl    String?    @map("avatar_url")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  teamMemberships TeamMember[]
  invitationsSent Invitation[]   @relation("InvitationCreatedBy")
  auditLogs      AuditLog[]
  inboxMemberships InboxMember[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  authoredMessages      Message[]      @relation("MessageAuthor")

  @@index([status])
  @@map("users")
}

/// Sessão de refresh. Uma linha por sessão ativa; a rotação cria uma nova linha
/// e marca a anterior como revogada, permitindo detectar reuso de token roubado.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 do token. O valor em claro só existe no cookie do cliente.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  /// Aponta para o token que substituiu este na rotação.
  replacedById String? @map("replaced_by_id") @db.Uuid
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Convite de novo membro. O token em claro só existe no link enviado por e-mail.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @db.VarChar(255)
  name        String    @db.VarChar(120)
  role        UserRole
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User? @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

/// Token de recuperação de senha. Uso único, validade curta.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members       TeamMember[]
  conversations Conversation[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Configuração de SMTP. Singleton — sempre no máximo uma linha, com id fixo.
model SmtpSettings {
  id                String   @id @default("default")
  host              String   @db.VarChar(255)
  port              Int
  /// true = TLS implícito (465). false = STARTTLS (587) ou sem TLS.
  secure            Boolean  @default(false)
  username          String?  @db.VarChar(255)
  /// AES-256-GCM. Nunca sai da API em nenhuma resposta.
  passwordEncrypted String?  @map("password_encrypted")
  fromName          String   @map("from_name") @db.VarChar(120)
  fromEmail         String   @map("from_email") @db.VarChar(255)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("smtp_settings")
}

// =============================================================================
// Fase 2 — Conexão com a WhatsApp Cloud API
// =============================================================================

/// Como o número foi conectado. Ver docs/adr/001-onboarding-duplo.md.
enum InboxOnboardingType {
  /// Cloud API pura: credenciais informadas manualmente pelo administrador.
  manual
  /// Coexistência: número segue ativo no app WhatsApp Business, conectado via
  /// Embedded Signup. Depende da aprovação como Tech Provider.
  coexistence
}

enum InboxConnectionStatus {
  /// Criada, mas ainda sem validação bem-sucedida contra a Graph API.
  pending
  connected
  /// Token revogado, número removido da WABA ou falha persistente.
  error
}

enum InboxTokenType {
  /// System User Token colado pelo administrador (modo manual).
  system_user
  /// Token escopado ao cliente, obtido pela troca do code do Embedded Signup.
  business
}

enum TemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  /// Pausado pela Meta por qualidade baixa. Volta a APPROVED sozinho.
  PAUSED
  /// Desabilitado após pausas repetidas. Não volta.
  DISABLED
  /// Estados menos comuns retornados pela Graph API.
  IN_APPEAL
  PENDING_DELETION
  DELETED
  LIMIT_EXCEEDED
}

/// Uma caixa de entrada é um número de WhatsApp conectado à plataforma.
model Inbox {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(120)
  /// Número em formato de exibição, como informado pelo administrador.
  phoneNumber    String              @map("phone_number") @db.VarChar(32)
  /// Identificador do número na Cloud API. Único: um número, uma caixa.
  phoneNumberId  String              @unique @map("phone_number_id") @db.VarChar(64)
  wabaId         String              @map("waba_id") @db.VarChar(64)

  /// AES-256-GCM. Nunca sai da API em nenhuma resposta.
  tokenEncrypted String              @map("token_encrypted")
  tokenType      InboxTokenType      @default(system_user) @map("token_type")

  /// Imutável após a criação — converter um número entre os modos exigiria
  /// tirá-lo da WABA atual, e números em coexistência não migram entre WABAs.
  onboardingType InboxOnboardingType @default(manual) @map("onboarding_type")

  connectionStatus InboxConnectionStatus @default(pending) @map("connection_status")
  /// Última mensagem de erro da Meta, para diagnóstico do administrador.
  connectionError  String?               @map("connection_error")
  lastValidatedAt  DateTime?             @map("last_validated_at")

  /// Teto de envio por segundo. Coexistência é fixa em 20 mps; Cloud API pura
  /// escalona conforme o tier da Meta. Lido pela fila de envio na Fase 3 —
  /// nunca use constante no código.
  throughputLimitMps Int      @default(80) @map("throughput_limit_mps")

  /// Preenchido ao concluir a sincronização inicial de histórico e contatos,
  /// que a Meta limita a 24h após o onboarding de coexistência.
  coexistenceSyncedAt DateTime? @map("coexistence_synced_at")

  // Dados espelhados da Graph API, exibidos na tela da caixa.
  verifiedName        String?   @map("verified_name") @db.VarChar(160)
  qualityRating       String?   @map("quality_rating") @db.VarChar(24)
  messagingTier       String?   @map("messaging_tier") @db.VarChar(48)
  wabaName            String?   @map("waba_name") @db.VarChar(160)
  wabaReviewStatus    String?   @map("waba_review_status") @db.VarChar(48)

  webhookSubscribedAt DateTime? @map("webhook_subscribed_at")

  /// Quando `true`, a assinatura envia `override_callback_uri` e a WABA passa
  /// a entregar os webhooks direto nesta API, ignorando a URL configurada no
  /// painel do app. Desligado por padrão porque o override *substitui* o
  /// destino: ligar tira o número de qualquer outro sistema que o receba hoje.
  /// Não cobre status de template — esse continua indo à URL padrão do app.
  webhookOverride     Boolean   @default(false) @map("webhook_override")

  templatesSyncedAt   DateTime? @map("templates_synced_at")

  /// Soft delete: conversas e histórico são preservados para consulta.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  members       InboxMember[]
  templates     Template[]
  conversations Conversation[]

  @@index([connectionStatus])
  @@index([deletedAt])
  @@map("inboxes")
}

/// Quais agentes atendem a caixa.
model InboxMember {
  inboxId String   @map("inbox_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inboxId, userId])
  @@index([userId])
  @@map("inbox_members")
}

/// Template de mensagem espelhado da WABA.
///
/// A fonte de verdade é a Meta: este registro é um cache sincronizado, nunca
/// editado diretamente. Alterações vão pela Graph API e voltam pelo sync ou
/// pelo webhook `message_template_status_update`.
model Template {
  id       String @id @default(uuid()) @db.Uuid
  inboxId  String @map("inbox_id") @db.Uuid
  /// Identificador do template na Meta.
  metaId   String @map("meta_id") @db.VarChar(64)
  name     String @db.VarChar(512)
  language String @db.VarChar(16)

  category TemplateCategory
  status   TemplateStatus

  /// Estrutura completa: header, body, footer e botões, como a Meta devolve.
  /// Guardada em bruto para renderizar o preview e montar o envio sem
  /// reinterpretar o formato dela.
  components Json

  /// Motivo da recusa, quando houver.
  rejectedReason String? @map("rejected_reason") @db.VarChar(255)
  qualityScore   String? @map("quality_score") @db.VarChar(24)

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  /// A Meta permite o mesmo nome em idiomas diferentes — o par é que é único.
  @@unique([inboxId, name, language])
  @@index([inboxId, status])
  @@map("templates")
}

// =============================================================================
// Fase 3 — Conversas
// =============================================================================

enum ConversationStatus {
  open
  resolved
}

enum ConversationPriority {
  none
  low
  medium
  high
  urgent
}

enum MessageDirection {
  /// Recebida do contato.
  in
  /// Enviada pela equipe — pela plataforma ou, em coexistência, pelo celular.
  out
}

enum MessageType {
  text
  image
  video
  audio
  document
  sticker
  location
  contacts
  reaction
  template
  /// Nota interna. Nunca é enviada à Meta.
  private_note
  /// Evento gerado pela própria plataforma (atribuição, resolução, etc.).
  system_event
  /// Tipo não reconhecido — preservado para não perder a mensagem.
  unsupported
}

enum MessageStatus {
  /// Aceita pela plataforma, ainda não confirmada pela Meta.
  pending
  sent
  delivered
  read
  failed
}

enum MessageOrigin {
  platform
  /// Enviada pelo app WhatsApp Business (Fase 7).
  coexistence_echo
  contact
  system
}

/// Pessoa do outro lado da conversa, identificada pelo número no WhatsApp.
model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  /// Identificador do WhatsApp em E.164 sem o "+". É o que a Meta devolve.
  waId        String   @unique @map("wa_id") @db.VarChar(32)
  /// Nome do perfil comercial informado pelo próprio contato.
  profileName String?  @map("profile_name") @db.VarChar(160)
  /// Nome editado pela equipe. Tem precedência na exibição.
  displayName String?  @map("display_name") @db.VarChar(160)
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("contacts")
}

/// Conversa contínua entre uma caixa de entrada e um contato.
///
/// É única por par (inbox, contact): resolver não cria conversa nova, e uma
/// nova mensagem reabre a existente. O histórico do atendimento fica em um
/// lugar só, como no WhatsApp.
model Conversation {
  id        String @id @default(uuid()) @db.Uuid
  inboxId   String @map("inbox_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid

  status     ConversationStatus   @default(open)
  priority   ConversationPriority @default(none)
  assigneeId String?              @map("assignee_id") @db.Uuid
  teamId     String?              @map("team_id") @db.Uuid

  /// Momento em que a janela de atendimento de 24h fecha. Renovada a cada
  /// mensagem recebida do contato. Fora dela, só template — regra da Meta.
  windowExpiresAt DateTime? @map("window_expires_at")

  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(280)
  /// Recebidas e ainda não lidas por nenhum agente.
  unreadCount        Int       @default(0) @map("unread_count")
  resolvedAt         DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inbox    Inbox     @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([inboxId, contactId])
  @@index([status, lastMessageAt])
  @@index([assigneeId, status])
  @@index([inboxId, status])
  @@map("conversations")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  direction MessageDirection
  type      MessageType
  origin    MessageOrigin    @default(platform)
  status    MessageStatus    @default(pending)

  /// Texto da mensagem, quando houver.
  content String? @db.Text
  /// Dados específicos do tipo: localização, contatos, reação, template
  /// renderizado, metadados do evento de sistema.
  payload Json?

  /// Identificador da mensagem na Meta. Índice único: é o que garante
  /// idempotência ponta a ponta, já que a Meta reentrega webhooks.
  waMessageId String? @unique @map("wa_message_id") @db.VarChar(128)
  /// Mensagem citada, quando é uma resposta.
  replyToWaId String? @map("reply_to_wa_id") @db.VarChar(128)

  /// Autor interno. Nulo quando vem do contato ou é evento de sistema.
  authorId String? @map("author_id") @db.Uuid

  /// Erro devolvido pela Meta em caso de falha no envio.
  errorPayload Json?     @map("error_payload")
  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  readAt       DateTime? @map("read_at")
  failedAt     DateTime? @map("failed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Arquivo vinculado a uma mensagem.
///
/// As URLs de mídia da Meta expiram em minutos, então o arquivo é baixado no
/// processamento do webhook e servido a partir do storage próprio.
model Attachment {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @map("message_id") @db.Uuid

  /// Identificador da mídia na Meta, quando houver.
  metaMediaId  String? @map("meta_media_id") @db.VarChar(128)
  /// Chave no storage próprio.
  storageKey   String  @map("storage_key")
  mimeType     String  @map("mime_type") @db.VarChar(120)
  sizeBytes    Int     @map("size_bytes")
  originalName String? @map("original_name") @db.VarChar(255)
  /// Duração em segundos, para áudio e vídeo.
  durationSeconds Int? @map("duration_seconds")
  /// Legenda enviada junto do arquivo.
  caption      String? @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

enum WebhookEventStatus {
  queued
  processing
  processed
  failed
  /// Esgotou as tentativas. Aguarda reprocessamento manual (Fase 6).
  dead
}

/// Evento bruto recebido da Meta.
///
/// Persistido antes de qualquer processamento: o ACK precisa sair rápido, e
/// guardar o payload cru permite reprocessar sem depender de a Meta reenviar.
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Chave de deduplicação derivada do conteúdo do evento.
  eventKey String @unique @map("event_key") @db.VarChar(200)
  /// Campo do webhook: messages, statuses, message_template_status_update…
  field    String @db.VarChar(80)
  wabaId   String? @map("waba_id") @db.VarChar(64)

  payload Json
  status  WebhookEventStatus @default(queued)
  attempts Int               @default(0)
  lastError String?          @map("last_error") @db.Text
  processedAt DateTime?      @map("processed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("webhook_events")
}

/// Trilha de auditoria de ações administrativas.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(60)
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
