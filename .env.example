# =============================================================================
# Sistema Coexistente Wpp — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env.
# =============================================================================

NODE_ENV=development

# --- API ---------------------------------------------------------------------
API_PORT=3333
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# URL pública do frontend — usada para montar links de convite e recuperação de senha
APP_URL=http://localhost:5173

# --- Banco de dados ----------------------------------------------------------
# Postgres local via docker compose:
#   DATABASE_URL=postgresql://coexistente:coexistente@localhost:5432/coexistente?schema=public
#   DIRECT_URL=postgresql://coexistente:coexistente@localhost:5432/coexistente?schema=public
#
# Supabase — copie de Project Settings → Database → Connection string (URI).
# São DUAS strings diferentes e as duas são necessárias:
#
#   DATABASE_URL  Transaction pooler, porta 6543. Usada em runtime.
#                 Acrescente ?pgbouncer=true&connection_limit=1 ao final.
#   DIRECT_URL    Direct connection, porta 5432. Usada pelas migrations —
#                 elas executam DDL, que o pooler em modo transaction não aceita.
#
# Exemplo (troque SENHA e o identificador do projeto):
#   DATABASE_URL=postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# --- Redis (fila BullMQ — usada a partir da Fase 3) --------------------------
REDIS_URL=redis://localhost:6379

# --- Meta / WhatsApp Cloud API -----------------------------------------------
# Versão da Graph API. A Meta descontinua versões com prazo — atualize aqui,
# nunca espalhado pelo código.
META_GRAPH_VERSION=v25.0

# App Secret do app no Meta Developers (Configurações > Básico).
# Valida a assinatura de TODO webhook recebido. Sem ele, qualquer um que
# descubra a URL consegue injetar mensagens falsas na plataforma.
META_APP_SECRET=

# Token que você escolhe e informa à Meta ao cadastrar a URL do webhook.
# Qualquer string longa e aleatória serve — ela só prova que a URL é sua.
META_WEBHOOK_VERIFY_TOKEN=

# Onde as mídias baixadas da Meta ficam guardadas. As URLs da Meta expiram em
# minutos, então o arquivo é baixado no recebimento e servido daqui.
STORAGE_DIR=./storage

# URL pública desta API. Em produção, o domínio real. Usada nos links de mídia e
# no registro automático do webhook — que só é oferecido quando esta URL é
# pública e https, porque a Meta precisa alcançá-la para verificar o endereço.
PUBLIC_API_URL=http://localhost:3333

# --- Segurança ---------------------------------------------------------------
# Segredo de assinatura dos JWT de acesso. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Marque como true quando o frontend estiver em um domínio diferente do da API
# (ex.: interface na Vercel e API em outro host). Exige HTTPS nos dois lados.
COOKIE_CROSS_SITE=false

# Chave de criptografia AES-256-GCM em repouso (tokens da Meta, senha do SMTP).
# DEVE ter exatamente 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Primeiro administrador (criado pelo seed) -------------------------------
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=

# --- SMTP de fallback --------------------------------------------------------
# O SMTP é configurável pela interface (Configurações → SMTP) e fica no banco.
# Estes valores são usados apenas enquanto não houver configuração salva —
# útil para o primeiro convite. Em desenvolvimento, apontam para o Mailhog.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Atendimento
SMTP_FROM_EMAIL=nao-responda@exemplo.com.br

# --- Web ---------------------------------------------------------------------
# ATENÇÃO: tudo com prefixo VITE_ é embutido no JavaScript entregue ao
# navegador e fica legível por qualquer visitante. Nunca coloque segredo aqui.
#
# É a ÚNICA variável que a Vercel precisa — ela hospeda só a interface.
# Na Vercel, aponte para o domínio da API, incluindo o /api no final:
#   VITE_API_URL=https://coexistente-api.onrender.com/api
VITE_API_URL=http://localhost:3333/api
